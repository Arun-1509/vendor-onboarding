# Copy to .env and export, or set in your host's dashboard. NEVER commit real keys.
# FREE option: get a key at aistudio.google.com (no card). Used when no Anthropic key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest      # optional; the app also auto-picks from the models your key can use
GEMINI_FALLBACK=gemini-flash-latest
ANTHROPIC_API_KEY=
# auto = use the real API when a key is present, otherwise offline mock mode. 1 forces mock, 0 forces live.
MOCK_LLM=auto
MODEL_EXTRACT=claude-sonnet-5-5   # reads documents (fast: it is on the live-demo critical path)
MODEL_JUDGE=claude-fable-5-1      # rare ambiguous-name judgment
MODEL_WRITE=claude-sonnet-5-5     # drafts emails
MODEL_FALLBACK=claude-sonnet-5-5  # used if the primary model refuses or is unavailable
BASE_URL=http://localhost:8000    # public URL; used for links inside emails
VAR_DIR=./var                     # database + uploads. Put on a persistent volume in production.
RATE_PER_HOUR=30                  # per-IP submissions/hour on the public link
DAILY_RUN_CAP=300                 # hard daily cap so a public link cannot drain the API budget
# GEMINI_API_KEY_2=   # optional spare key from a different Google project (own free quota)
