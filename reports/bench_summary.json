 "findings": [
  {
   "set": "holdout",
   "found": "A lookalike of an existing vendor reused its tax ID and bank account but switched the contact to a ProtonMail address, and was approved.",
   "fix": "An existing vendor whose contact email moves to another domain goes to a reviewer (account takeover starts with the mailbox)."
  },
  {
   "set": "holdout",
   "found": "A new company used an existing vendor's exact contact email and was approved.",
   "fix": "One mailbox used by two different companies goes to a reviewer, like a shared bank account."
  },
  {
   "set": "holdout",
   "found": "An edited bank STATEMENT was only refused as the wrong document; the edit was never flagged.",
   "fix": "The tamper check runs on every uploaded file, including ones then refused as the wrong kind."
  },
  {
   "set": "holdout",
   "found": "'O'Connell' vs 'OConnell' and 'Brand, a trade name of Company LLC' were treated as different payees; a street number differing from the certificate (same city) was approved.",
   "fix": "Apostrophes join words; 'a trade/trading/business name of X' resolves to X; same postcode/city but another street number asks the vendor to confirm."
  },
  {
   "set": "diverse",
   "found": "Bank-letter dates printed as 10/07/2026 or 9 November 2026 were not matched to the ISO date the reader returns, so the 90-day check silently skipped them.",
   "fix": "Dates are compared as dates (all common styles); a bank letter without a verifiable date now asks the vendor (DOC_UNDATED)."
  },
  {
   "set": "diverse",
   "found": "A fraudster pasting over only the account NUMBER (not the whole 'IBAN: ...' line) was not detected.",
   "fix": "Two different texts drawn at the same spot of a page are flagged as a pasted-over value, whatever the field."
  },
  {
   "set": "blind",
   "found": "The account holder was never screened: a clean company asking to be paid into a sanctioned party's account was not rejected.",
   "fix": "Form and bank-letter account holders are screened against the sanctions list."
  },
  {
   "set": "blind",
   "found": "A name containing a sanctioned entity's whole distinctive name ('Meridian Crest Logistics') was approved.",
   "fix": "Sharing the full distinctive part of a listed name goes to compliance review."
  },
  {
   "set": "blind",
   "found": "Payments to a third party (factoring company, a director personally) were sent back to the vendor instead of a reviewer.",
   "fix": "Policy change: a clearly different account holder is a third-party payee -> reviewer with four-eyes (my own earlier labels were relabelled)."
  },
  {
   "set": "blind",
   "found": "A wholly different account on the form vs the bank letter was treated like a typo; another company's tax registration was treated like an upload slip.",
   "fix": "Typo vs different account is measured; a tax ID registered to a differently named company -> reviewer."
  },
  {
   "set": "blind",
   "found": "Honest variants were held: 'M/s' prefix, 'DBA' account titles, 'UG (haftungsbeschraenkt)', swapped upload slots, company PAN with the wrong dropdown.",
   "fix": "Recognised as variants or form slips (vendor asked to correct the type); swapped documents are read as what they are."
  },
  {
   "set": "blind",
   "found": "A bank statement was accepted as bank proof; a US domestic account in EUR was accepted.",
   "fix": "Statements are recognised and the vendor is asked for a bank letter; a foreign currency on a domestic-only account asks the vendor to confirm."
  },
  {
   "set": "fresh",
   "found": "Three vendors were approved with something plainly wrong on the form: 'LLC' selected for a company named '... Inc.', a W-9 with the tax-number box empty, and a contact email with a comma in it.",
   "fix": "The dropdown is checked against the legal form in the company's own name; a document must actually show the number it is meant to prove; email addresses are validated properly."
  },
  {
   "set": "fresh",
   "found": "A contact domain spelling the company's name with digits ('carro11ton' for Carrollton) was approved.",
   "fix": "A domain that turns into a word of the company name once digits are read as letters goes to a reviewer."
  },
  {
   "set": "fresh",
   "found": "Fraud-shaped cases were sent back to the vendor: a future-dated bank letter, two different VALID tax IDs for one company, a cheque in a sister company's name, a franchisor's tax certificate, an Indian supplier asking for dollars into a US account.",
   "fix": "Future dates, different valid tax IDs (a slip fails the check digit), a holder name with a whole word swapped, another entity's registration from another town, and offshore payment in a foreign currency all go to a reviewer."
  },
  {
   "set": "fresh",
   "found": "Honest German and Indian spellings were held: 'Mueller und Soehne' vs 'M\u00fcller & S\u00f6hne', 'AG' vs 'Aktiengesellschaft', '3S' vs '3 S'.",
   "fix": "Umlauts typed out, 'und' / '&', legal forms written in full and moved spaces are recognised as the same name."
  }
 ],
